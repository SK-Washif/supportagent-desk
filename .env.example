# Copy this file to backend/.env (PowerShell: Copy-Item .env.example backend/.env).
# Never commit the real .env file.

# --- AI provider: Groq (free tier, no credit card) ---------------------------------------
# Create a key at https://console.groq.com/keys  (it starts with gsk_)
GROQ_API_KEY=
# Main model and a fallback with its own separate rate limit. Both are free-tier models.
# If Groq retires a model, pick another one from https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Any OpenAI-compatible endpoint works, e.g. a local Ollama: http://localhost:11434/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- App ---------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./supportagent.db
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
MAX_AGENT_ITERATIONS=5
